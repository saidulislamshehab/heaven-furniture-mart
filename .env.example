# All variables are server-side only — never prefix with VITE_ (that would expose them to the browser).
# The assistant tries providers in this order and falls through on rate limits / errors.

# 1) Any OpenAI-compatible server. Locally, run the free-LLM pool proxy
#    (https://github.com/0xzr/freellmpool):  pip install freellmpool && freellmpool proxy --port 8787
#    Leave LLM_BASE_URL empty on Vercel (the proxy is local-only).
LLM_BASE_URL=http://127.0.0.1:8787/v1
LLM_API_KEY=
LLM_MODEL=llm7/default,auto

# 2) OpenRouter free models (free accounts have a daily request cap).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m2.7:free,google/gemma-4-31b-it:free,openrouter/free

# 3) LLM7 (https://api.llm7.io) — keyless hosted fallback, always enabled. A key raises limits.
LLM7_API_KEY=
LLM7_MODEL=default,fast
